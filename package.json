{
  "name": "enerwire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_PROXY_TARGET=http://127.0.0.1:5005 vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:docker": "cross-env VITE_PROXY_TARGET=http://127.0.0.1:5005 vite",
    "dev:local": "cross-env VITE_PROXY_TARGET=http://127.0.0.1:5000 vite",
    "backend": "cd backend && docker-compose up --build -d",
    "backend:down": "cd backend && docker-compose down",
    "backend:legacy": "cd backend && docker-compose -f docker-compose1.yml up --build -d",
    "backend:legacy:down": "cd backend && docker-compose -f docker-compose1.yml down",
    "smoke": "python backend/tests/smoke.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10",
    "cross-env": "^7.0.3"
  }
}
