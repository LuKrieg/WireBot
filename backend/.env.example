SECRET_KEY=change-this-in-production
JWT_EXPIRATION_HOURS=8
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
# Cuántas filas del Excel (las más similares a la pregunta) se envían al modelo. No recorre todo el archivo.
RAG_TOP_K=100
# Máximo de filas extra cuando la pregunta pide listar (p. ej. “todas las trefiladoras”) por coincidencia de texto.
RAG_LISTADO_MAX=500
UPLOAD_FOLDER=/app/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Ollama on the host (Windows), not Flask ---
# Set these in the environment where you run `ollama serve`, e.g. OLLAMA_NUM_THREAD=8
# for ~8 physical CPU cores. GPU use depends on Ollama build and drivers. See DEV_RUNTIME.md.
